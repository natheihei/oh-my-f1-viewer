{
  "manifest_version": 3,
  "name": "f1a",
  "version": "0.1.0",
  "description": "Agent-driven F1 multi-view streaming app, running entirely in the browser.",
  "key": "",
  "minimum_chrome_version": "122",
  "action": {
    "default_title": "Open f1a",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.formula1.com/*",
    "https://*.akamaized.net/*",
    "https://*.akamaihd.net/*",
    "https://api.multiviewer.app/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "folder.html",
    "open_in_tab": true
  }
}
