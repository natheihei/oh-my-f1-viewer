// The site runs on Cloudflare Workers with static assets, with no adapter or Worker script.
// See DEPLOY.md for how it's built, released and rolled back.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Production: built by Workers Builds from the `site-production` branch.
  "name": "omfv-site",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Only the custom domain serves the site, with no workers.dev address or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "oh-my-f1-viewer.yueyao.run", "custom_domain": true }],

  "env": {
    // Staging: deploys as `omfv-site-staging`, built by Workers Builds from `main`.
    // Its domain sits behind a Cloudflare Access application, so only the owner can open it.
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "omfv-staging.yueyao.run", "custom_domain": true }]
    }
  }
}
