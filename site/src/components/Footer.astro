---
import { DISCORD_HREF, REPO_HREF, X_HREF } from '../site';
---

<footer class="border-t border-[#1d1d1d]">
  <div class="wrap flex flex-col gap-2.5 pt-8 pb-12 text-[13px] leading-relaxed text-dim">
    <span class="mono text-[#b9b9b9]">oh-my-f1-viewer · a fan project</span>
    <span class="mono flex flex-wrap gap-x-4 gap-y-1">
      <a class="text-dim hover:text-paper" href={REPO_HREF}>GitHub</a>
      <a class="text-dim hover:text-paper" href={X_HREF}>X</a>
      {DISCORD_HREF && <a class="text-dim hover:text-paper" href={DISCORD_HREF}>Discord</a>}
    </span>
    <span class="max-w-[80ch]">
      OMFV is unofficial and isn't affiliated with, endorsed by or connected to Formula 1, F1 TV or the Formula One group
      of companies. F1, Formula 1 and F1 TV are their trademarks. Parts of the sign-in and playback come from F1
      OpenViewer (MIT).
    </span>
  </div>
</footer>
