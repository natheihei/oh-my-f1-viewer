---
/**
 * What the app does, told as you scroll: four steps, each with its own screen recording of the app on the 2026 Las
 * Vegas race: a headline, with the video under it as wide as the page, or as wide as fits on a short screen.
 * The recordings are public videos on Vimeo, muted, with no sound track. Each is an ordinary Vimeo player that plays by
 * itself and loops (the account is on the free plan, so it can't hide the player's controls or branding). Looping also
 * keeps it from ending on Vimeo's screen of the account's other videos. Each loads as you get near it.
 */

interface Step {
  title: string;
  note?: string;
  /** The video's id on Vimeo */
  vimeo: string;
  /** About /build, so it's in build mode's yellow */
  build?: boolean;
}

const steps: Step[] = [
  { title: 'Say what you want to watch. It sets up the screen.', vimeo: '1249810164' },
  { title: 'A growing gallery of charts.', vimeo: '1249810163' },
  { title: 'No chart for it? The agent builds one.', note: 'no code needed', vimeo: '1249810166', build: true },
  { title: 'Tweak it in your own words.', vimeo: '1249810165', build: true },
];

const src = (id: string) =>
  `https://player.vimeo.com/video/${id}?${new URLSearchParams({
    muted: '1',
    autoplay: '1',
    loop: '1',
    autopause: '0',
    playsinline: '1',
    title: '0',
    byline: '0',
    portrait: '0',
    dnt: '1',
  })}`;
---

<section id="story" class="band story-band">
  <div class="wrap flex flex-col">
    {
      steps.map((s, i) => (
        <article id={`step-${i + 1}`} class:list={['step', { build: s.build }]}>
          <div class="words">
            <h2 class="disp h3">{s.title}</h2>
            {s.note && <p class="hand step-note">{s.note}</p>}
          </div>
          <figure class="player">
            <!-- The recordings are the app's window, 1684×1080, not 16:9, so the frame matches them and has no black bars -->
            <div class="frame">
              <iframe
                src={src(s.vimeo)}
                title={`Screen recording: ${s.title}`}
                allow="autoplay; fullscreen; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                loading={i ? 'lazy' : 'eager'}
              />
            </div>
          </figure>
        </article>
      ))
    }
  </div>
</section>

<style>
  .story-band {
    padding-block: 56px 120px;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-block: 72px;
  }
  .step + .step {
    border-top: 1px solid #1d1d1d;
  }
  /* The headline, centred over the video, with a note beside it when there's room */
  .words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    align-items: baseline;
    gap: 8px 24px;
  }
  .h3 {
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.05;
  }
  .step-note {
    font-size: 28px;
    color: var(--color-build);
  }

  /* As wide as the page, unless the screen is too short to show all of it under the headline */
  .player {
    margin: 0;
    width: 100%;
    max-width: calc((100svh - 140px) * 1684 / 1080);
    min-width: 0;
  }
  .frame {
    aspect-ratio: 1684 / 1080;
    border: 1px solid #2c2c2c;
    background: #000;
  }
  .step.build .frame {
    border-color: var(--color-build);
  }
  .frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 620px) {
    .step {
      gap: 20px;
      padding-block: 48px;
    }
  }
</style>

