---
import Arrow from './Arrow.astro';
import HeroReel from './HeroReel.astro';
import { BETA_HREF } from '../site';
---

<header class="wrap flex flex-wrap items-center justify-between gap-4 py-5">
  <a href="#top" class="flex items-center gap-2.5 no-underline">
    <svg width="26.4" height="26" viewBox="30 30 132 130" aria-hidden="true" style="flex: none">
      <path
        fill="#161616"
        stroke="#e7e7e7"
        stroke-width="7"
        stroke-linejoin="round"
        d="M96 33.5C136 33.5 158.5 61 158.5 98L158.5 122C158.5 144 145 156.5 124 156.5L68 156.5C47 156.5 33.5 144 33.5 122L33.5 98C33.5 61 56 33.5 96 33.5Z"
      ></path>
      <rect fill="#e7e7e7" x="48" y="78" width="96" height="44" rx="18"></rect>
      <path fill="#ff3b30" d="M68 88L78.08 88L90.08 100L78.08 112L68 112L80 100Z"></path>
      <rect fill="#0d0d0d" x="103" y="88" width="13" height="24"></rect>
      <rect fill="#e7e7e7" x="80" y="137" width="32" height="6"></rect>
    </svg>
    <span class="mono text-[15px] font-bold">oh-my-f1-viewer</span>
    <span class="mono bg-paper px-1.5 py-0.5 text-[10px] tracking-[0.08em] text-ink">BETA</span>
  </a>
  <nav class="mono flex flex-wrap items-center gap-6 text-[13px]">
    <a href="#ask" class="text-[#b9b9b9] no-underline">Features</a>
    <a href="#build" class="text-build no-underline">/build</a>
    <a class="btn" href={BETA_HREF} style="min-height: 36px; padding: 0 14px; font-size: 13px">Join the beta</a>
  </nav>
</header>

<div id="top" class="wrap flex flex-col gap-12 pt-14 pb-[72px]">
  <div class="flex max-w-[980px] flex-col gap-6">
    <h1 class="disp" style="font-size: clamp(34px, 5.4vw, 70px); line-height: 1.04">
      Your F1 viewer,<br />with an AI <span class="sr-only">TV director and race engineer.</span><span class="role" aria-hidden="true"
        ><span class="text-signal">TV director</span><span class="text-build">race engineer</span></span
      >
    </h1>
    <p class="mono m-0 flex items-center gap-3.5 font-bold" style="font-size: clamp(28px, 4vw, 48px)">
      <Arrow />
      <span>Just ask.</span><span class="cursor" aria-hidden="true"></span>
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn" href={BETA_HREF}>Join the beta</a>
      <span class="mono pl-1 text-xs leading-relaxed text-dim">
        A fan project · Needs F1 TV and{' '}
        <span class="tip" tabindex="0"
          >an LLM provider<span class="tip-pop"
            >A ChatGPT plan, or an API key from a provider like Anthropic (Claude) or OpenAI.</span
          ></span
        >
      </span>
    </div>
    <p class="hand -mt-2.5 pl-1" style="font-size: 26px">↑ open source soon. still doing formation laps</p>
  </div>

  <HeroReel />
</div>

<style>
  /* The two jobs it does, one after the other in the same place, each in its own colour. They share one grid cell,
     so the box is as wide as the longer one (wrapping only on the narrowest phones) and sits on the headline's
     baseline. Under reduced motion it stays on the first */
  .role {
    display: inline-grid;
  }
  .role > span {
    grid-area: 1 / 1;
    animation: role 7s infinite;
  }
  .role > span + span {
    opacity: 0;
    animation-delay: -3.5s;
  }
  @keyframes role {
    0% {
      opacity: 0;
      transform: translateY(0.25em);
    }
    6%,
    44% {
      opacity: 1;
      transform: none;
    }
    50%,
    100% {
      opacity: 0;
      transform: translateY(-0.25em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .role > span {
      animation: none;
    }
  }
</style>
