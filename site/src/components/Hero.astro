---
import { Image } from 'astro:assets';
import logo from '../assets/omfv-logo.svg';
---

<section class="mx-auto flex max-w-4xl flex-col items-start gap-8 px-4 py-24 sm:px-8">
  <Image src={logo} alt="OMFV, oh-my-f1-viewer" class="h-auto w-56" />
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
    Your own F1 viewer: any car, any chart, any moment. <span class="text-signal">Just ask.</span>
  </h1>
</section>
