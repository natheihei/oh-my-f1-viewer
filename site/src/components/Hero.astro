---
import Arrow from './Arrow.astro';
import HeroReel from './HeroReel.astro';
import GitHubMark from './GitHubMark.astro';
import Star from './Star.astro';
import Header from './Header.astro';
import { DOWNLOAD_HREF, PLATFORMS, REPO_HREF } from '../site';
---

<Header />

<div id="top" class="wrap flex flex-col gap-12 pt-14 pb-[72px]">
  <div class="flex max-w-[980px] flex-col gap-6">
    <a
      href={REPO_HREF}
      class="mono flex w-fit items-center gap-2 border border-[#2c2c2c] bg-[#161616] px-2.5 py-1.5 text-xs text-[#cfcfcf] no-underline hover:border-[#8f8f8f] hover:text-paper"
    >
      <GitHubMark size={13} />
      Free and open source<span class="text-dim">·</span>MIT licensed
    </a>
    <h1 class="disp" style="font-size: clamp(34px, 5.4vw, 70px); line-height: 1.04">
      Your F1 viewer,<br />with an AI <span class="sr-only">TV director and race engineer.</span><span class="role" aria-hidden="true"
        ><span class="text-signal">TV director</span><span class="text-build">race engineer</span></span
      >
    </h1>
    <p class="mono m-0 flex items-center gap-3.5 font-bold" style="font-size: clamp(28px, 4vw, 48px)">
      <Arrow />
      <span>Just ask.</span><span class="cursor" aria-hidden="true"></span>
    </p>
    <div class="flex flex-col gap-1">
      <div class="flex flex-wrap items-center gap-3">
        <a class="btn" href={DOWNLOAD_HREF}>Download</a>
        <a class="btn btn-ghost btn-star" href={REPO_HREF}><GitHubMark />Star on GitHub</a>
      </div>
      <!-- The note's arrow sits under the GitHub mark: a hidden copy of Download holds its place, so it lines up whatever the font -->
      <div class="flex gap-3">
        <span class="btn invisible" style="min-height: 0; height: 0" aria-hidden="true">Download</span>
        <p class="hand pl-3" style="font-size: 26px">↑ a <Star /><span class="sr-only">star</span> really helps me keep pushing</p>
      </div>
    </div>
    <p class="mono m-0 -mt-1 pl-1 text-xs leading-relaxed text-dim">
      For {PLATFORMS} · Needs F1 TV and{' '}
      <span class="tip" tabindex="0"
        >an LLM provider<span class="tip-pop"
          >A ChatGPT plan, or an API key from a provider like Anthropic (Claude) or OpenAI.</span
        ></span
      >
    </p>
  </div>

  <HeroReel />
</div>

<style>
  /* The two jobs it does, one after the other in the same place, each in its own colour. They share one grid cell,
     so the box is as wide as the longer one (wrapping only on the narrowest phones) and sits on the headline's
     baseline. Under reduced motion it stays on the first */
  .role {
    display: inline-grid;
  }
  .role > span {
    grid-area: 1 / 1;
    animation: role 7s infinite;
  }
  .role > span + span {
    opacity: 0;
    animation-delay: -3.5s;
  }
  @keyframes role {
    0% {
      opacity: 0;
      transform: translateY(0.25em);
    }
    6%,
    44% {
      opacity: 1;
      transform: none;
    }
    50%,
    100% {
      opacity: 0;
      transform: translateY(-0.25em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .role > span {
      animation: none;
    }
  }
</style>
