---
import { Image } from 'astro:assets';
import Ticker from './Ticker.astro';
import strip from '../assets/shots/page/s1-strip.webp';

const prompts = ['battle HAM vs VER', 'follow Norris', "who's struggling on their tyres?", 'could Leclerc pit now?'];

// What each request gets: the tiles the agent suggests for it
const requests = [
  { say: 'battle HAM vs VER', get: ['Onboard HAM', 'Onboard VER', 'Gap HAM · VER'] },
  { say: 'follow Norris', get: ['Chase NOR', 'Car telemetry NOR'] },
  { say: "who's struggling on their tyres?", get: ['Tyre deg', 'Tyre strategy'] },
  { say: 'could Leclerc pit now?', get: ['Pit window LEC'] },
];
---

<section id="ask" class="band">
  <div class="wrap flex flex-col gap-12">
    <div class="flex flex-wrap items-end gap-x-16 gap-y-8">
      <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-[18px]">
        <p class="eyebrow"><b>›</b> <Ticker prompts={prompts} /></p>
        <h2 class="disp h2">Say what you want to watch, and it sets up the screen.</h2>
      </div>
      <p class="hand min-w-0 flex-[1_1_380px]" style="font-size: 30px">
        it picks the onboards and charts for you ↓
      </p>
    </div>

    <div class="flex flex-wrap gap-6">
      <div class="card flex-[1_1_480px]">
        <div
          class="mono grid gap-4 border-b border-[#232323] px-[18px] py-3.5 text-[11px] tracking-[0.08em] text-dim"
          style="grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr)"
        >
          <span>YOU SAY</span><span>YOU GET</span>
        </div>
        {
          requests.map((r) => (
            <div
              class="grid min-h-[52px] items-center gap-4 border-b border-[#1d1d1d] px-[18px] py-3.5 last:border-b-0"
              style="grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr)"
            >
              <span class="mono text-sm">
                <span class="font-bold text-signal">›</span> {r.say}
              </span>
              <span class="flex flex-wrap gap-1.5">
                {r.get.map((g) => (
                  <span class="chip">{g}</span>
                ))}
              </span>
            </div>
          ))
        }
      </div>

      <div class="flex min-w-0 flex-[1_1_520px] flex-col justify-center">
        <Image
          src={strip}
          alt="The palette after asking how Verstappen is doing: a strip of six suggested tiles, each a live preview, for his onboard, the timing tower, tyres, tyre degradation, his pit window and his telemetry."
          widths={[600, 1143]}
          sizes="(min-width: 1240px) 600px, calc(100vw - 32px)"
          class="shot"
        />
      </div>
    </div>

    <div class="flex flex-wrap gap-x-12 gap-y-6">
      <div class="flex flex-[1_1_300px] flex-col gap-1.5">
        <span class="mono text-[13px]">In sync</span>
        <span class="text-[15px] leading-[1.55] text-[#9a9a9a]">Every feed and chart shows the same moment.</span>
      </div>
      <div class="flex flex-[1_1_300px] flex-col gap-1.5">
        <span class="mono text-[13px]">Arrange it yourself</span>
        <span class="text-[15px] leading-[1.55] text-[#9a9a9a]"
          >Drag, swap or resize any tile, or let <span
            class="mono border border-[#2c2c2c] bg-black px-1.5 py-px text-[13px] whitespace-nowrap text-paper"
            >/auto-layout</span
          > arrange them.</span
        >
      </div>
      <div class="flex flex-[1_1_300px] flex-col gap-1.5">
        <span class="mono text-[13px]">Change it mid-race</span>
        <span class="text-[15px] leading-[1.55] text-[#9a9a9a]"
          ><span class="say"><b>&gt;</b>follow Piastri instead</span> switches to Piastri.</span
        >
      </div>
    </div>
  </div>
</section>
