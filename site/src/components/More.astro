---
import { Image } from 'astro:assets';
import mention from '../assets/shots/page/x1-mention.webp';
import { TEAM } from '../site';
---

<section id="more" class="band">
  <div class="wrap grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr))">
    <div class="card gap-3.5 p-[22px]">
      <Image
        src={mention}
        alt="In the palette, Ferrari and Mercedes are tags, and the @ picker is on the gap chart on screen, which is lit while every other tile dims."
        widths={[560, 1120, 1780]}
        sizes="(min-width: 1240px) 560px, calc(100vw - 80px)"
        class="shot"
      />
      <div class="mono flex flex-wrap items-center gap-2 border border-[#2c2c2c] bg-black px-3 py-2.5 text-[13px]">
        <span class="font-bold text-signal">&gt;</span><span>how is</span>
        <span class="code border border-[#5a5a5a] px-[5px] py-px"
          ><i style={`background: ${TEAM.ferrari}`}></i><i style={`background: ${TEAM.ferrari}`}></i>FERRARI</span
        >
        <span>doing against</span>
        <span class="code border border-[#5a5a5a] px-[5px] py-px"
          ><i style={`background: ${TEAM.mercedes}`}></i><i style={`background: ${TEAM.mercedes}`}></i>MERCEDES</span
        >
        <span>on the</span>
        <span class="code border border-paper bg-paper px-[5px] py-px text-ink">GAP</span>
      </div>
      <span class="mono text-[13px]">Point at anything</span>
      <span class="text-[15px] leading-[1.55] text-[#9a9a9a]">Type @ to name a driver, a team or a tile.</span>
    </div>

    <div class="card gap-3.5 p-[22px]">
      <div class="mono flex min-h-[46px] flex-wrap items-center gap-x-4 gap-y-2.5 text-xs">
        <span class="bg-signal px-[7px] py-[3px] font-bold text-black">LIVE</span>
      </div>
      <span class="mono flex items-center gap-2 text-[13px]"
        >Live races too <span class="bg-paper px-[5px] py-px text-[10px] tracking-[0.08em] text-ink">ALPHA</span></span
      >
      <span class="text-[15px] leading-[1.55] text-[#9a9a9a]">Rewind and catch up while it's on.</span>
      <p class="hand mt-2" style="font-size: 28px">waiting for live races to test and fix bugs...</p>
    </div>
  </div>
</section>
