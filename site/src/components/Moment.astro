---
/**
 * The jump, as screens one after another like the hero: the race on lap 22, then the screen dims and the prompt types,
 * the spoiler check comes up and Allow once is pressed, then Verstappen on Hamilton on lap 37.
 * Frames are shots 6d and 6e (shots/hero/SHOTS.md). Without JavaScript it's the race on lap 22. Under reduced motion it
 * starts paused there, and the prompt appears whole.
 */
import { Image } from 'astro:assets';
import Ticker from './Ticker.astro';
import Palette from './Palette.astro';
import race from '../assets/shots/page/m1-race.webp';
import jump from '../assets/shots/page/m1-jump.webp';

const prompts = ['go to when VER caught HAM', 'back to the restart', 'take me to lap 30', 'show me that overtake again'];
// What was typed for shot 6a
const PROMPT = 'go to when VER caught HAM after his pit stop';
const sizes = '(min-width: 1240px) 640px, calc(100vw - 32px)';
---

<section id="moment" class="band">
  <div class="wrap flex flex-wrap items-center gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-[22px]">
      <p class="eyebrow"><b>›</b> <Ticker prompts={prompts} offset={3} /></p>
      <h2 class="disp h2">Skip to any moment, with no spoilers.</h2>
      <div class="flex flex-col gap-3.5 pt-2">
        <div class="flex items-baseline gap-3.5">
          <span class="mono font-bold text-signal">!</span><span class="text-[15px] leading-[1.55]"
            >It asks you before it looks ahead in the race.</span
          >
        </div>
        <div class="flex items-baseline gap-3.5">
          <span class="mono font-bold text-signal">!</span><span class="text-[15px] leading-[1.55]"
            >Nothing on screen shows what you haven't reached yet.</span
          >
        </div>
      </div>
    </div>

    <div class="flex min-w-0 flex-[1_1_520px] flex-col gap-2.5">
      <p class="hand pb-1.5 pl-1">skip the slow laps, go straight to the fight ↓</p>
      <div class="reel shot" data-moment-reel data-prompt={PROMPT} style="--palette-size: clamp(10px, 2.5cqw, 16px)">
        <Image
          src={race}
          alt="The 2026 Italian Grand Prix on lap 22, with the two Mercedes ahead and Verstappen behind them."
          widths={[640, 1280, 1920]}
          sizes={sizes}
          class="reel-img on"
        />
        <Image
          src={jump}
          alt="Asked to go to when Verstappen caught Hamilton after his pit stop, and allowed once to look ahead, it jumps to lap 37: Verstappen on Hamilton down the straight, with Hamilton still fourth and Verstappen fifth on the tower."
          widths={[640, 1280, 1920]}
          sizes={sizes}
          class="reel-img"
        />
        <div class="dim" data-dim></div>
        <Palette spoiler />
      </div>
      <div class="mono flex justify-end text-xs">
        <button type="button" class="reel-toggle" data-moment-toggle aria-pressed="false">pause</button>
      </div>
    </div>
  </div>
</section>

<style>
  /* The race, dimmed to almost dark while you ask */
  .dim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .dim.on {
    opacity: 0.86;
  }
  @media (prefers-reduced-motion: reduce) {
    .dim {
      transition: none;
    }
  }
</style>

<script>
  import { clock, palette, showFrame } from '../scripts/reel';

  const reel = document.querySelector<HTMLElement>('[data-moment-reel]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-moment-toggle]');
  if (reel && toggle) {
    const frames = [...reel.querySelectorAll<HTMLImageElement>('.reel-img')];
    const dim = reel.querySelector<HTMLElement>('[data-dim]')!;
    const prompt = reel.dataset.prompt ?? '';
    const { ready, wait } = clock(reel, toggle, 'the jump');
    const pal = palette(reel.querySelector<HTMLElement>('[data-palette]')!, wait);

    const play = async () => {
      // The slow laps
      await ready();
      showFrame(frames, 0);
      await wait(2600);
      // It dims, and you ask
      dim.classList.add('on');
      await pal.ask(prompt);
      // It asks first, and you allow it
      await pal.allow();
      // The jump
      pal.hide();
      showFrame(frames, 1);
      dim.classList.remove('on');
      await wait(6500);
      // A beat of empty screen, so it's clear it starts over
      showFrame(frames, -1);
      await wait(1600);
    };

    (async () => {
      for (;;) await play();
    })();
  }
</script>
