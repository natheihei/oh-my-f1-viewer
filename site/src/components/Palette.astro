---
/**
 * The app's palette, centred on a reel's empty screen while a prompt types into it. `palette()` in scripts/reel.ts
 * drives it through the classes on its root: show, keys (typing), sent (Enter pressed), busy (the agent working), and
 * with `spoiler`, asking (the spoiler check) and pressing / pressed (Allow once).
 */
interface Props {
  /** Draws the spoiler check the app asks before the agent looks ahead, hidden until it's asking */
  spoiler?: boolean;
}
const { spoiler = false } = Astro.props;
---

<div class="palette mono" aria-hidden="true" data-palette>
  <div class="palette-sent"><span class="palette-mark">&gt;</span> <span data-sent></span></div>
  {
    spoiler && (
      <div class="palette-ask">
        <div>
          <span class="palette-spoiler">! spoiler</span> The agent wants to look ahead of where you are.
        </div>
        <div class="palette-buttons">
          <span class="palette-btn palette-allow">Allow once</span>
          <span class="palette-btn">Allow for this session</span>
          <span class="palette-btn">Don't allow</span>
        </div>
      </div>
    )
  }
  <div class="palette-input">
    <span class="palette-mark palette-arrow" data-mark>&gt;</span><span data-typed></span><span
      class="palette-caret"></span><span class="palette-placeholder">ask for anything on screen</span>
  </div>
</div>

<style>
  /* Centred and bigger than in the app. The reel is a size container, so the type scales with it. A reel can set
     --palette-size for its own scale */
  .palette {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(88%, 820px);
    background: #1b1b1b;
    border: 1px solid #3a3a3a;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.6);
    font-size: var(--palette-size, clamp(13px, 2cqw, 24px));
    line-height: 1.45;
    color: #e7e7e7;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .palette.show {
    opacity: 1;
  }
  .palette-sent {
    display: none;
    padding: 0.55em 0.9em;
    background: #262626;
    border-bottom: 1px solid #2c2c2c;
  }
  .palette-sent .palette-mark {
    color: #8f8f8f;
  }
  .palette.sent .palette-sent {
    display: block;
  }
  /* Long prompts wrap, so the whole of one is readable */
  .palette-input {
    padding: 0.7em 0.9em;
  }
  .palette-arrow {
    color: #ff3b30;
    font-weight: 700;
    margin-right: 0.6em;
  }
  /* While the agent works, the app's prompt mark is a pulsing "…" */
  .palette.busy .palette-arrow {
    animation: palette-pulse 1s steps(2) infinite;
  }
  .palette.busy .palette-caret {
    display: none;
  }
  @keyframes palette-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .palette-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: #e7e7e7;
    margin-left: 1px;
    vertical-align: -0.2em;
    animation: blink 1.1s steps(1) infinite;
  }
  .palette.keys .palette-caret {
    animation: none;
  }
  .palette-placeholder {
    color: #6f6f6f;
    margin-left: 0.4em;
  }
  .palette.keys .palette-placeholder {
    display: none;
  }

  /* The spoiler check, as the app asks it: Allow once is picked, and gets pressed */
  .palette-ask {
    display: none;
    padding: 0.7em 0.9em;
    border-bottom: 1px solid #2c2c2c;
  }
  .palette.asking .palette-ask {
    display: block;
  }
  .palette-spoiler {
    color: #ff3b30;
    font-weight: 700;
  }
  .palette-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: 0.6em;
  }
  .palette-btn {
    display: inline-block;
    border: 1px solid #3a3a3a;
    padding: 0.15em 0.6em;
    color: #cfcfcf;
  }
  .palette-allow {
    background: #e7e7e7;
    border-color: #e7e7e7;
    color: #0d0d0d;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition:
      outline-color 0.2s ease,
      background 0.1s ease;
  }
  .palette.pressing .palette-allow {
    outline-color: #ff3b30;
  }
  .palette.pressed .palette-allow {
    background: #fff;
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .palette {
      transition: none;
    }
    .palette-caret,
    .palette.busy .palette-arrow {
      animation: none;
    }
  }
</style>
