---
/**
 * The app's palette, centred on a reel's empty screen while a prompt types into it. `palette()` in scripts/reel.ts
 * drives it through the classes on its root: show, keys (typing), sent (Enter pressed), busy (the agent working).
 */
---

<div class="palette mono" aria-hidden="true" data-palette>
  <div class="palette-sent"><span class="palette-mark">&gt;</span> <span data-sent></span></div>
  <div class="palette-input">
    <span class="palette-mark palette-arrow" data-mark>&gt;</span><span data-typed></span><span
      class="palette-caret"></span><span class="palette-placeholder">ask for anything on screen</span>
  </div>
</div>

<style>
  /* Centred and bigger than in the app. The reel is a size container, so the type scales with it */
  .palette {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(88%, 820px);
    background: #1b1b1b;
    border: 1px solid #3a3a3a;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.6);
    font-size: clamp(13px, 2cqw, 24px);
    line-height: 1.45;
    color: #e7e7e7;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .palette.show {
    opacity: 1;
  }
  .palette-sent {
    display: none;
    padding: 0.55em 0.9em;
    background: #262626;
    border-bottom: 1px solid #2c2c2c;
  }
  .palette-sent .palette-mark {
    color: #8f8f8f;
  }
  .palette.sent .palette-sent {
    display: block;
  }
  /* Long prompts wrap, so the whole of one is readable */
  .palette-input {
    padding: 0.7em 0.9em;
  }
  .palette-arrow {
    color: #ff3b30;
    font-weight: 700;
    margin-right: 0.6em;
  }
  /* While the agent works, the app's prompt mark is a pulsing "…" */
  .palette.busy .palette-arrow {
    animation: palette-pulse 1s steps(2) infinite;
  }
  .palette.busy .palette-caret {
    display: none;
  }
  @keyframes palette-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .palette-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: #e7e7e7;
    margin-left: 1px;
    vertical-align: -0.2em;
    animation: blink 1.1s steps(1) infinite;
  }
  .palette.keys .palette-caret {
    animation: none;
  }
  .palette-placeholder {
    color: #6f6f6f;
    margin-left: 0.4em;
  }
  .palette.keys .palette-placeholder {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .palette {
      transition: none;
    }
    .palette-caret,
    .palette.busy .palette-arrow {
      animation: none;
    }
  }
</style>
