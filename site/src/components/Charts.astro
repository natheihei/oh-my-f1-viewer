---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ticker from './Ticker.astro';
import battle from '../assets/shots/page/c1-battle.webp';
import chase from '../assets/shots/page/c2-chase.webp';
import tower from '../assets/shots/page/c3-tower.webp';
import gap from '../assets/shots/page/c4-gap.webp';
import ribbon from '../assets/shots/page/c5-ribbon.webp';
import pedals from '../assets/shots/page/c6-pedals.webp';
import deg from '../assets/shots/page/c7-deg.webp';
import pit from '../assets/shots/page/c8-pit.webp';

const prompts = [
  "who's struggling on their tyres?",
  'is the gap closing?',
  'where is Piastri quicker than Norris?',
  'where would Leclerc rejoin if he pitted?',
];

type Card =
  | { kind: 'chart'; name: string; desc: string; img: ImageMetadata; alt: string }
  | { kind: 'build' }
  | { kind: 'more' };

const chart = (name: string, desc: string, img: ImageMetadata, alt: string): Card => ({ kind: 'chart', name, desc, img, alt });

// Two rows that drift in opposite directions. Top, moving left; bottom, moving right.
const rows: { rev: boolean; cards: Card[] }[] = [
  {
    rev: false,
    cards: [
      chart('Battle', 'Two onboards from the closest fight on track.', battle, "Hamilton's onboard over the list of fights: Verstappen and Hamilton for P1, 0.6 s apart."),
      chart('Chase', 'One onboard, with the gap to the car ahead.', chase, "Verstappen's onboard, with Hamilton 1.4 s ahead."),
      chart('Gap', 'Is the car behind closing, and close enough to attack?', gap, 'The gap from Verstappen to Hamilton over eight laps, closing to 0.5 s, in overtake range.'),
      chart('Timing tower', 'The running order, with gaps and tyres.', tower, 'The timing tower with Hamilton and Leclerc highlighted.'),
      { kind: 'build' },
    ],
  },
  {
    rev: true,
    cards: [
      chart('Speed ribbon', 'One lap on the circuit: speed, throttle and brake.', ribbon, "Hamilton's lap of Suzuka, green on the throttle through the Esses and red where he brakes."),
      chart('Tyre deg', 'How fast each set of tyres is falling off.', deg, 'Tyre degradation for the whole field, with the top three on 31-lap softs highlighted.'),
      chart('Pit window', 'Where a driver would rejoin if they stopped now.', pit, 'If Hamilton pits now he rejoins P17, from P3, in traffic.'),
      chart('Pedal barcode', 'Brake and throttle, lap after lap.', pedals, "Hamilton's brake and throttle on each of his last six laps, lined up by turn."),
      { kind: 'more' },
    ],
  },
];

const more = ['Sector table', 'Tyre strategy', 'Race control', 'Track map'];
---

<section id="charts" class="band">
  <div class="wrap flex flex-col gap-10">
    <div class="flex min-w-0 flex-col gap-[18px]">
      <p class="eyebrow"><b>›</b> <Ticker prompts={prompts} offset={6} /></p>
      <h2 class="disp h2">A growing gallery of charts.</h2>
    </div>
  </div>

  <div class="marquee">
    {
      rows.map((row) => (
        <div class="marquee-row">
          <div class:list={['marquee-track', { rev: row.rev }]}>
            {/* Each row holds its cards four times so the loop has no gap. Only the first copy is read out or reachable by Tab. */}
            {[0, 1, 2, 3].map((copy) =>
              row.cards.map((card) =>
                card.kind === 'chart' ? (
                  <div class="card flex-[0_0_320px]" aria-hidden={copy ? 'true' : undefined}>
                    <div class="aspect-[16/10] overflow-hidden border-b border-[#232323] bg-black">
                      <Image src={card.img} alt={copy ? '' : card.alt} widths={[320, 640]} sizes="320px" class="h-full w-full object-cover object-top" />
                    </div>
                    <div class="flex flex-col gap-1.5 px-4 pt-3.5 pb-4">
                      <span class="mono text-[13px] font-bold">{card.name}</span>
                      <span class="text-sm leading-normal text-[#9a9a9a]">{card.desc}</span>
                    </div>
                  </div>
                ) : card.kind === 'build' ? (
                  <a
                    href="#build"
                    tabindex={copy ? -1 : undefined}
                    aria-hidden={copy ? 'true' : undefined}
                    class="mono flex flex-[0_0_240px] flex-col justify-center gap-2.5 border border-dashed border-build p-[22px] text-build no-underline hover:text-build"
                  >
                    <span class="text-[44px] leading-none font-bold">+</span>
                    <span class="text-sm font-bold">the one you build</span>
                  </a>
                ) : (
                  <div class="card flex-[0_0_320px] gap-4 p-[22px]" aria-hidden={copy ? 'true' : undefined}>
                    <span class="mono text-[11px] tracking-[0.08em] text-dim">AND MORE</span>
                    <div class="flex flex-wrap gap-2">
                      {more.map((m) => (
                        <span class="chip" style="font-size: 13px; padding: 7px 11px">
                          {m}
                        </span>
                      ))}
                    </div>
                  </div>
                ),
              ),
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
