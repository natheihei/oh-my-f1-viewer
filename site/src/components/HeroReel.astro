---
/**
 * The hero: real screenshots of the app, each after its prompt is typed into the palette, the way the app draws it.
 * The prompt types on an empty screen of its own, Enter sends it, the app's "…" pulses while the agent works, and the
 * screenshot it got fades in. Then the next.
 * Without JavaScript it's the first screenshot. Under reduced motion it starts paused, and prompts appear whole.
 */
import { Image } from 'astro:assets';
import Palette from './Palette.astro';
import battle from '../assets/shots/page/hero-battle.webp';
import onboards from '../assets/shots/page/hero-onboards.webp';
import lead from '../assets/shots/page/hero-lead.webp';
import charts from '../assets/shots/page/hero-charts.webp';

// Each prompt is the one that was typed into the app for that screenshot (see shots/hero/SHOTS.md).
const slides = [
  {
    img: battle,
    prompt: 'The battle between HAM and VER, with their telemetry',
    alt: "Asked for the battle between Hamilton and Verstappen, on the 2026 Canadian Grand Prix: the world feed, both onboards, the gap between them and each car's speed, gear and pedals.",
  },
  {
    img: onboards,
    prompt: 'Onboards of the top 10, and jump to 10 seconds before lights out',
    alt: 'Asked for the onboards of the top 10, ten seconds before lights out at the 2026 Mexico City Grand Prix: the grid formed up under five red lights, and ten onboards.',
  },
  {
    img: lead,
    prompt: 'the battle for the race lead',
    alt: 'Asked for the battle for the race lead, on lap 49 in Mexico City: the world feed, and the battle tile with Verstappen and Hamilton 0.6 s apart for P1, over a list of every fight on track.',
  },
  {
    img: charts,
    prompt: 'All charts focusing on HAM vs. LEC',
    alt: 'Asked for all charts on Hamilton against Leclerc: both onboards and fifteen charts, from pit windows and the gap to speed ribbons, pedals, sectors, tyres and the track map.',
  },
];
---

<div class="flex flex-col gap-2.5">
  <div class="reel shot" data-hero-reel>
    {
      slides.map((s, i) => (
        <Image
          src={s.img}
          alt={s.alt}
          widths={[800, 1240, 1600, 2400]}
          sizes="(min-width: 1240px) 1208px, calc(100vw - 32px)"
          loading={i ? 'lazy' : 'eager'}
          fetchpriority={i ? undefined : 'high'}
          class:list={['reel-img', { on: i === 0 }]}
          data-prompt={s.prompt}
        />
      ))
    }
    <Palette />
  </div>
  <div class="mono flex justify-end text-xs">
    <button type="button" class="reel-toggle" data-hero-toggle aria-pressed="false">pause</button>
  </div>
</div>

<script>
  import { clock, palette, showFrame } from '../scripts/reel';

  const reel = document.querySelector<HTMLElement>('[data-hero-reel]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (reel && toggle) {
    const imgs = [...reel.querySelectorAll<HTMLImageElement>('.reel-img')];
    const { ready, wait } = clock(reel, toggle, 'the screenshots');
    const pal = palette(reel.querySelector<HTMLElement>('[data-palette]')!, wait);

    const play = async (i: number) => {
      // Paused on the screenshot it's showing, with nothing over it
      await ready();
      // An empty screen, the prompt typed and sent, then what it got
      showFrame(imgs, -1);
      await pal.ask(imgs[i].dataset.prompt ?? '');
      showFrame(imgs, i);
      pal.hide();
      await wait(5200);
    };

    (async () => {
      for (let i = 0; ; i = (i + 1) % imgs.length) await play(i);
    })();
  }
</script>
