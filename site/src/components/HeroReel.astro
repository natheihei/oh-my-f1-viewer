---
/**
 * The hero: real screenshots of the app, each after its prompt is typed into the palette, the way the app draws it.
 * The prompt types on an empty screen of its own, Enter sends it, the app's "…" pulses while the agent works, and the
 * screenshot it got fades in. Then the next.
 * Without JavaScript it's the first screenshot. Under reduced motion it starts paused, and prompts appear whole.
 */
import { Image } from 'astro:assets';
import battle from '../assets/shots/page/hero-battle.webp';
import onboards from '../assets/shots/page/hero-onboards.webp';
import lead from '../assets/shots/page/hero-lead.webp';
import charts from '../assets/shots/page/hero-charts.webp';

// Each prompt is the one that was typed into the app for that screenshot (see shots/hero/SHOTS.md).
const slides = [
  {
    img: battle,
    prompt: 'The battle between HAM and VER, with their telemetry',
    alt: "Asked for the battle between Hamilton and Verstappen, on the 2026 Canadian Grand Prix: the world feed, both onboards, the gap between them and each car's speed, gear and pedals.",
  },
  {
    img: onboards,
    prompt: 'Onboards of the top 10, and jump to 10 seconds before lights out',
    alt: 'Asked for the onboards of the top 10, ten seconds before lights out at the 2026 Mexico City Grand Prix: the grid formed up under five red lights, and ten onboards.',
  },
  {
    img: lead,
    prompt: 'the battle for the race lead',
    alt: 'Asked for the battle for the race lead, on lap 49 in Mexico City: the world feed, and the battle tile with Verstappen and Hamilton 0.6 s apart for P1, over a list of every fight on track.',
  },
  {
    img: charts,
    prompt: 'All charts focusing on HAM vs. LEC',
    alt: 'Asked for all charts on Hamilton against Leclerc: both onboards and fifteen charts, from pit windows and the gap to speed ribbons, pedals, sectors, tyres and the track map.',
  },
];
---

<div class="flex flex-col gap-2.5">
  <div class="reel shot relative aspect-video overflow-hidden" data-reel>
    {
      slides.map((s, i) => (
        <Image
          src={s.img}
          alt={s.alt}
          widths={[800, 1240, 1600, 2400]}
          sizes="(min-width: 1240px) 1208px, calc(100vw - 32px)"
          loading={i ? 'lazy' : 'eager'}
          fetchpriority={i ? undefined : 'high'}
          class:list={['reel-img', { on: i === 0 }]}
          data-prompt={s.prompt}
        />
      ))
    }
    <div class="reel-palette mono" aria-hidden="true">
      <div class="reel-sent"><span class="reel-mark">&gt;</span> <span data-sent></span></div>
      <div class="reel-input">
        <span class="reel-mark reel-arrow" data-mark>&gt;</span><span data-typed></span><span class="reel-caret"></span><span
          class="reel-placeholder"
          data-placeholder>ask for anything on screen</span
        >
      </div>
    </div>
  </div>
  <div class="mono flex justify-end text-xs">
    <button type="button" class="reel-toggle" data-toggle aria-pressed="false">pause</button>
  </div>
</div>

<style>
  .reel {
    container-type: inline-size;
  }
  /* <Image> renders outside this component's scope, so these rules reach it with :global */
  .reel :global(.reel-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .reel :global(.reel-img.on) {
    opacity: 1;
  }
  /* The palette as the app draws it, on an empty screen of its own between screenshots: centred, and bigger */
  .reel-palette {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(88%, 820px);
    background: #1b1b1b;
    border: 1px solid #3a3a3a;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.6);
    font-size: clamp(13px, 2cqw, 24px);
    line-height: 1.45;
    color: #e7e7e7;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .reel.typing .reel-palette {
    opacity: 1;
  }
  .reel-sent {
    display: none;
    padding: 0.55em 0.9em;
    background: #262626;
    border-bottom: 1px solid #2c2c2c;
  }
  .reel-sent .reel-mark {
    color: #8f8f8f;
  }
  .reel.sent .reel-sent {
    display: block;
  }
  /* Long prompts wrap, so the whole of one is readable */
  .reel-input {
    padding: 0.7em 0.9em;
  }
  .reel-arrow {
    color: #ff3b30;
    font-weight: 700;
    margin-right: 0.6em;
  }
  /* While the agent works, the app's prompt mark is a pulsing "…" */
  .reel.busy .reel-arrow {
    animation: reel-pulse 1s steps(2) infinite;
  }
  .reel.busy .reel-caret {
    display: none;
  }
  @keyframes reel-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .reel-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: #e7e7e7;
    margin-left: 1px;
    vertical-align: -0.2em;
    animation: blink 1.1s steps(1) infinite;
  }
  .reel.keys .reel-caret {
    animation: none;
  }
  .reel-placeholder {
    color: #6f6f6f;
    margin-left: 0.4em;
  }
  .reel.keys .reel-placeholder {
    display: none;
  }

  .reel-toggle {
    color: #8f8f8f;
    background: none;
    border: 0;
    padding: 4px 2px;
    min-height: 32px;
    cursor: pointer;
  }
  .reel-toggle:hover {
    color: #e7e7e7;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel :global(.reel-img),
    .reel-palette {
      transition: none;
    }
    .reel-caret,
    .reel.busy .reel-arrow {
      animation: none;
    }
  }
</style>

<script>
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
  if (reel && toggle) {
    const imgs = [...reel.querySelectorAll<HTMLImageElement>('.reel-img')];
    const typed = reel.querySelector<HTMLElement>('[data-typed]')!;
    const mark = reel.querySelector<HTMLElement>('[data-mark]')!;
    const sent = reel.querySelector<HTMLElement>('[data-sent]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let paused = reduce;
    let visible = true;
    let wake: (() => void) | null = null;
    const running = () => !paused && visible && !document.hidden;
    const resume = () => {
      if (running() && wake) {
        wake();
        wake = null;
      }
    };
    // Waits, and keeps waiting while paused, off screen or in a hidden tab
    const wait = async (ms: number) => {
      await new Promise((r) => setTimeout(r, ms));
      while (!running()) await new Promise<void>((r) => (wake = r));
    };

    const setPaused = (p: boolean) => {
      paused = p;
      toggle.textContent = p ? 'play' : 'pause';
      toggle.setAttribute('aria-pressed', String(p));
      toggle.setAttribute('aria-label', p ? 'Play the screenshots' : 'Pause the screenshots');
      resume();
    };
    toggle.addEventListener('click', () => setPaused(!paused));
    setPaused(paused);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      resume();
    }).observe(reel);
    document.addEventListener('visibilitychange', resume);

    const show = (i: number) => imgs.forEach((img, j) => img.classList.toggle('on', j === i));

    const play = async (i: number) => {
      const prompt = imgs[i].dataset.prompt ?? '';
      // Paused on the screenshot it's showing, with nothing over it
      while (!running()) await new Promise<void>((r) => (wake = r));
      // An empty screen, and the palette, empty
      reel.classList.remove('sent', 'keys', 'busy');
      mark.textContent = '>';
      typed.textContent = '';
      show(-1);
      reel.classList.add('typing');
      await wait(900);
      // The prompt types, a key at a time
      reel.classList.add('keys');
      if (reduce) typed.textContent = prompt;
      else
        for (let n = 1; n <= prompt.length; n++) {
          typed.textContent = prompt.slice(0, n);
          await wait(28 + Math.random() * 45);
        }
      await wait(reduce ? 1200 : 500);
      // Enter: it goes up into the history, and the agent works, with the app's pulsing "…"
      sent.textContent = prompt;
      typed.textContent = '';
      reel.classList.remove('keys');
      reel.classList.add('sent', 'busy');
      mark.textContent = '…';
      await wait(1500);
      // What it got
      show(i);
      reel.classList.remove('typing');
      await wait(5200);
    };

    (async () => {
      for (let i = 0; ; i = (i + 1) % imgs.length) await play(i);
    })();
  }
</script>
