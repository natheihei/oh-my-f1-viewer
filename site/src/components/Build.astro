---
import { Image } from 'astro:assets';
import Ticker from './Ticker.astro';
import draft from '../assets/shots/page/b1-draft.webp';
import badge from '../assets/ferrari-badge.png';

// Things to follow that no tile shows, so the agent offers to build one (see docs/BUILD_MODE.md, "Offered from view mode")
const prompts = [
  "show whoever's pitting",
  'track how often NOR opens DRS',
  "always show the leader's onboard",
  'the gap to the car behind, on every onboard',
];
const sizes = '(min-width: 1240px) 680px, calc(100vw - 32px)';
---

<section id="build" class="band" style="background: #ffd12e; color: #0d0d0d; border-top: none">
  <div class="wrap flex flex-wrap items-center gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-[22px]">
      <p class="eyebrow" style="color: #3d3400">
        <b style="color: #0d0d0d">›</b>
        <Ticker prompts={prompts} offset={9} />
      </p>
      <h2 class="disp h2 text-ink">No chart for it? The agent builds one.</h2>
      <p class="lead" style="color: #2b2500">
        Ask to follow something no chart shows, and the agent builds one for you.
      </p>
      <div class="hand text-ink" style="font-size: 30px">
        <p class="m-0">no code needed</p>
        <p class="m-0 mt-2 flex items-center gap-3 font-bold" style="color: #e8002d">
          <Image src={badge} alt="Ferrari badge" width={36} height={48} class="h-12 w-9 flex-none object-contain" />
          <span>we’re <s>checking</s> building.</span>
        </p>
      </div>
    </div>

    <div class="build-shot min-w-0 flex-[1_1_560px]" style="filter: drop-shadow(0 18px 40px rgba(60, 45, 0, 0.35))">
      <!-- Points down at the draft tile, top right in the crop -->
      <p class="hand build-note text-ink" aria-hidden="true">the agent built this ↓</p>
      <Image
        src={draft}
        alt="Build mode on the 2026 Mexico City Grand Prix, under the safety car: a new tile, framed in yellow and marked DRAFT, shows Russell's onboard in the pit lane with 'RUS pitting' over it."
        widths={[680, 1360]}
        sizes={sizes}
        class="shot"
        style="border-color: #0d0d0d"
      />
      <!-- The palette for this shot (3b in shots/hero/SHOTS.md), drawn here so its text is sharp. It's the way in the app
           takes when the viewer just asks: the agent finds no tile for it and offers build mode, the viewer says yes (the offer
           goes once answered), and the build agent starts on what was asked -->
      <div class="bp mono">
        <div class="bp-row bp-said">
          <span class="bp-mark">&gt;</span><span>show whoever's pitting, with their name over the onboard</span>
        </div>
        <div class="bp-row"><span></span><span>No tile follows the pit lane. Offered to build one.</span></div>
        <div class="bp-row bp-note">
          <span>#</span><span>Build mode. Save keeps what gets built, Undo all puts everything back.</span>
        </div>
        <div class="bp-row bp-note">
          <span>#</span><span>Asked the build agent to build an onboard of whoever's pitting.</span>
        </div>
        <div class="bp-row bp-note"><span>#</span><span>wrote pitting_onboard/main.tsx · loaded</span></div>
        <div class="bp-row">
          <span></span><span>Built Pitting onboard. It follows the most recent car in the pit lane and shows a centered driver overlay.</span>
        </div>
        <div class="bp-row bp-input">
          <span class="bp-arrow">&gt;</span><span class="bp-placeholder">describe a tile to build, or a change to one</span>
          <span class="bp-tags"><span>BUILD · 1 CHANGE</span><span class="bp-undo">UNDO ALL</span><span class="bp-save">SAVE</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The screenshot, cropped so the built tile is large at its top right, with the palette over the main feed to its left.
     The palette stops short of the tile's left edge (57% across), so however tall it wraps it never covers it. A size container, so the palette's type scales with the picture; when that's too small to read, the palette
     goes under it */
  .build-shot {
    position: relative;
    container-type: inline-size;
  }
  .bp {
    position: absolute;
    left: 1.5%;
    bottom: 2.5%;
    width: 54%;
    padding-top: 0.25em;
    background: #1a1a1a;
    border: 1px solid #ffd12e;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
    font-size: clamp(9px, 1.8cqw, 13px);
    line-height: 1.5;
    color: #e7e7e7;
  }
  /* Over the right side, so its arrow lands on the tile */
  .build-note {
    margin: 0 0 6px;
    padding-right: 14%;
    text-align: right;
    font-size: 26px;
    line-height: 1;
  }
  /* Every row has a column for its mark (> said, # from the app), so text and its wrapped lines line up */
  .bp-row {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    padding: 0.3em 0.9em;
  }
  .bp-said {
    background: #262626;
    margin-block: 0.15em;
  }
  .bp-said > :first-child,
  .bp-note {
    color: #8f8f8f;
  }
  /* The input on one line: its placeholder gives way to the build tag */
  .bp-input {
    grid-template-columns: 2ch minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0;
    margin-top: 0.35em;
    padding-block: 0.55em;
    border-top: 1px solid #2c2c2c;
  }
  .bp-arrow {
    color: #ffd12e;
    font-weight: 700;
  }
  .bp-placeholder {
    color: #6f6f6f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bp-tags {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin-left: 1em;
    color: #ffd12e;
    font-size: 0.82em;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .bp-undo,
  .bp-save {
    padding: 0.1em 0.45em;
    border: 1px solid #ffd12e;
  }
  .bp-save {
    background: #ffd12e;
    color: #0d0d0d;
  }
  @container (max-width: 520px) {
    .bp {
      position: static;
      width: auto;
      margin-top: 10px;
      font-size: 11px;
    }
    /* The build tag under the placeholder, so it reads whole */
    .bp-input {
      grid-template-columns: 2ch minmax(0, 1fr);
      row-gap: 0.6em;
    }
    .bp-tags {
      grid-column: 2;
      margin-left: 0;
    }
  }
</style>
